# == Network ==

# Use a public hostname or a stable LAN IP reachable by viewers and headsets
QUESTRELAY_DOMAIN=relay.example.com
QUESTRELAY_RTC_ANNOUNCED_ADDRESS=relay.example.com
QUESTRELAY_EGRESS_BUDGET_MBPS=200

# Use "tls internal" on a LAN or leave blank for a public ACME certificate
QUESTRELAY_TLS=

# Set the public HTTPS origin for passkeys or leave blank to disable them
QUESTRELAY_WEBAUTHN_ORIGIN=https://relay.example.com

# == Secrets ==

# Generate three different values with openssl rand -hex 32
QUESTRELAY_PUBLISH_KEY=
QUESTRELAY_VIEW_KEY=
QUESTRELAY_ADMIN_KEY=

# == Capacity ==

QUESTRELAY_MAX_HEADSETS=8
QUESTRELAY_MAX_VIEWERS=64
