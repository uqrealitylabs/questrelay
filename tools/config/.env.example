# Public DNS name with ports 80, 443 and 44444 reachable by viewers and headsets
QUESTRELAY_DOMAIN=relay.example.com
QUESTRELAY_RTC_ANNOUNCED_ADDRESS=relay.example.com
QUESTRELAY_EGRESS_BUDGET_MBPS=200

# Generate three different values with: openssl rand -hex 32
QUESTRELAY_PUBLISH_KEY=
QUESTRELAY_VIEW_KEY=
QUESTRELAY_ADMIN_KEY=

QUESTRELAY_MAX_HEADSETS=8
QUESTRELAY_MAX_VIEWERS=64
